# Copiá este archivo como .env y completá los valores. NUNCA commitees .env.

# Path al vault de Obsidian (notas de sesión + captura de decisiones)
# Ej. Windows: VAULT_PATH=D:\Usuarios\tu-usuario\Programas\obsidian-vault
# Ej. Unix:    VAULT_PATH=/home/tu-usuario/obsidian-vault
VAULT_PATH=

# Variables de la aplicación (completar según proyecto)
# APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/plataforma_clientes.db
SECRET_KEY=
